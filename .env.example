# ============================================================
# Kaley AI — environment variables
# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file (it is gitignored).
# ============================================================

# --- Anthropic (ideation + scriptwriting) -------------------
ANTHROPIC_API_KEY=

# --- ElevenLabs (voiceover) ---------------------------------
ELEVENLABS_API_KEY=
# The voice to narrate with (find IDs in your ElevenLabs voice library)
ELEVENLABS_VOICE_ID=
# Optional model override (defaults to eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Pexels (stock B-roll) ----------------------------------
PEXELS_API_KEY=

# --- OpenAI (Whisper captions) ------------------------------
OPENAI_API_KEY=

# --- Creatomate (video assembly) ----------------------------
CREATOMATE_API_KEY=
# The Creatomate template ID configured for a 1080x1920 9:16 video
CREATOMATE_TEMPLATE_ID=

# --- Blotato (publishing to TikTok + YouTube Shorts) --------
BLOTATO_API_KEY=
# Connected account IDs from your Blotato dashboard
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_YOUTUBE_ACCOUNT_ID=

# --- YouTube OAuth (optional direct upload fallback) --------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Google Sheets (analytics logging, service account) -----
# Path to the downloaded service-account JSON key file
GOOGLE_SHEETS_CREDENTIALS=./config/google-sheets-credentials.json
# The spreadsheet ID (from the sheet URL)
GOOGLE_SHEETS_ID=
# Tab names used by the agent
GOOGLE_SHEETS_LOG_TAB=Log
GOOGLE_SHEETS_ANALYTICS_TAB=Analytics
