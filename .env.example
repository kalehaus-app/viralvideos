# ── Claude API (script + trend + packaging) ───────────────────────────────────
# Required for real (non-dry-run) generation. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Voiceover / TTS (optional — pick at most one) ─────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# ── Visuals (optional) ────────────────────────────────────────────────────────
# Stock footage provider key, if you wire one in (see agents/visuals.py).
STOCK_API_KEY=

# ── YouTube Data API v3 (optional — needed only to upload) ────────────────────
# Path to the OAuth client secrets you downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Where the refreshable OAuth token is cached after the first interactive auth.
YOUTUBE_TOKEN_FILE=youtube_token.json

# ── Overrides (optional) ──────────────────────────────────────────────────────
# Any config.yaml value can be overridden via VIRALAGENT__SECTION__KEY=value
# e.g. VIRALAGENT__CONTENT__CADENCE_HOURS=6
